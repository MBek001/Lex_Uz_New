# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lex_uz_db

# Or if using Docker:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/lex_uz_db

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Upload Settings
MAX_UPLOAD_SIZE=5368709120  # 5GB in bytes
TEMP_DIR=/tmp
