# CRITICAL: Environment Variables

# Database Configuration
# The database name in PostgreSQL is "lexuz" (without underscore)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=2005
DB_NAME=lexuz
DB_DRIVER=postgresql

# AI Service Configuration
# IMPORTANT: Remove quotes from URLs and API key
EMB_URL=https://p950-w002-runai-r01-p950.runai-inference.dc.uz/v1/embeddings
LLM_URL=https://p950-w003-runai-r01-p950.runai-inference.dc.uz/v1/chat/completions
API_KEY=5df1454b1e95b2648fd89d

# AI Model Names (adjust these based on your AI service)
# Common Qwen models: Qwen/Qwen2.5-72B-Instruct, Qwen/Qwen2-7B-Instruct
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Upload Settings
MAX_UPLOAD_SIZE=5368709120
TEMP_DIR=/tmp
